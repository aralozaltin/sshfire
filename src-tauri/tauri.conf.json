{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSHFire",
  "version": "0.1.9",
  "identifier": "com.local.sshistemci",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SSHFire",
        "width": 1100,
        "height": 700,
        "minWidth": 720,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyOUI0QjBGNDYzQkUyRUMKUldUczRqdEdEMHViTWhzamNLMWp4OGNIL3BCWnczMTZITkx0bHVKTlFOMGlkOUZDSjBzVDRqMW8K",
      "endpoints": [
        "https://github.com/aralozaltin/sshfire/releases/latest/download/latest.json"
      ]
    }
  }
}
